# shellcheck shell=bash
# pacman runs this as root after the files are in place. It turns on
# discovery, opens the command port, starts the agent, and puts the
# pill on the bar. The desktop user does not type those commands.

plugin_id=io.github.mariusfanu.nudgelan
plugin_src=/usr/share/nudgelan/plugins/$plugin_id
omarchy_path="${OMARCHY_PATH:-/usr/share/omarchy}"

target_users() {
  if [ -n "${SUDO_USER:-}" ] && [ "$SUDO_USER" != root ]; then
    printf '%s\n' "$SUDO_USER"
    return 0
  fi
  loginctl list-users --no-legend 2>/dev/null | awk '{print $2}'
}

user_home() {
  getent passwd "$1" | cut -d: -f6
}

runtime_dir_for() {
  local uid
  uid=$(id -u "$1") || return
  printf '/run/user/%s\n' "$uid"
}

as_user() {
  local user runtime_dir home
  user=$1
  shift
  runtime_dir=$(runtime_dir_for "$user") || return
  home=$(user_home "$user")
  runuser -u "$user" -- env \
    HOME="$home" \
    USER="$user" \
    LOGNAME="$user" \
    XDG_RUNTIME_DIR="$runtime_dir" \
    DBUS_SESSION_BUS_ADDRESS="unix:path=$runtime_dir/bus" \
    OMARCHY_PATH="$omarchy_path" \
    PATH="/usr/bin:/bin" \
    "$@"
}

copy_plugin() {
  # Home directories belong to the desktop user. Never follow their symlinks
  # while running as root, including during package upgrades and removal.
  as_user "$1" sh -eu -s -- "$plugin_src" "$plugin_id" <<'SH'
source=$1
dest="$HOME/.config/omarchy/plugins/$2"
mkdir -p "$HOME/.config/omarchy/plugins"
rm -rf -- "$dest"
mkdir -p "$dest"
cp -R -- "$source/." "$dest/"
SH
}

place_in_shell_json() {
  as_user "$1" sh -eu -s -- "$plugin_id" "$omarchy_path" <<'SH'
config="$HOME/.config/omarchy/shell.json"
source_file=$config
if [ ! -s "$source_file" ]; then
  source_file="$2/config/omarchy/shell.json"
fi
[ -s "$source_file" ] || exit 1
mkdir -p "$HOME/.config/omarchy"
tmp=$(mktemp "$config.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT HUP INT TERM
jq -S --arg id "$1" '
    def object_or_empty: if type == "object" then . else {} end;
    def array_or_empty: if type == "array" then . else [] end;
    def entry_id: if type == "object" then .id else . end;
    object_or_empty
    | .version = 1
    | .bar = (.bar | object_or_empty)
    | .bar.layout = (.bar.layout | object_or_empty)
    | .bar.layout.left = (.bar.layout.left | array_or_empty)
    | .bar.layout.center = (.bar.layout.center | array_or_empty)
    | .bar.layout.right = (.bar.layout.right | array_or_empty)
    | .plugins = (.plugins | array_or_empty)
    | if ([.bar.layout.left[], .bar.layout.center[], .bar.layout.right[], .plugins[]] | map(entry_id) | index($id)) != null then .
      else .bar.layout.right += [{"id": $id}]
      end
' "$source_file" >"$tmp" || exit 1
chmod 644 "$tmp"
mv -f -- "$tmp" "$config"
SH
}

strip_shell_json() {
  as_user "$1" sh -eu -s -- "$plugin_id" <<'SH'
config="$HOME/.config/omarchy/shell.json"
[ -s "$config" ] || exit 0
tmp=$(mktemp "$config.XXXXXX")
trap 'rm -f -- "$tmp"' EXIT HUP INT TERM
jq -S --arg id "$1" '
    def entry_id: if type == "object" then .id else . end;
    def kept: if type == "array" then map(select(entry_id != $id)) else . end;
    .bar.layout.left |= kept
    | .bar.layout.center |= kept
    | .bar.layout.right |= kept
    | .plugins |= kept
' "$config" >"$tmp" || exit 1
chmod 644 "$tmp"
mv -f -- "$tmp" "$config"
SH
}

enable_plugin() {
  local user runtime_dir
  user=$1
  runtime_dir=$(runtime_dir_for "$user") || return
  if [ ! -d "$runtime_dir" ]; then
    place_in_shell_json "$user"
    echo "==> $user is not logged in. The NudgeLAN pill appears at the next graphical login."
    return 0
  fi
  if ! as_user "$user" omarchy-shell shell ping >/dev/null 2>&1; then
    place_in_shell_json "$user"
    echo "==> The Omarchy shell is not running. The NudgeLAN pill appears at the next login."
    return 0
  fi
  as_user "$user" omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  if as_user "$user" omarchy plugin enable "$plugin_id" --section right; then
    return 0
  fi
  sleep 1
  as_user "$user" omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  as_user "$user" omarchy plugin enable "$plugin_id" --section right
}

start_agent() {
  local user runtime_dir
  user=$1
  runtime_dir=$(runtime_dir_for "$user") || return
  [ -d "$runtime_dir" ] || return 0
  # configure_user handles startup failures, so do not rely on errexit here.
  as_user "$user" systemctl --user daemon-reload || return 1
  if as_user "$user" systemctl --user --quiet is-active nudgelan-agent.service; then
    as_user "$user" systemctl --user restart nudgelan-agent.service
  else
    as_user "$user" systemctl --user start nudgelan-agent.service
  fi
}

# The panel treats the port as open only when UFW has an interface rule for
# the address the agent is actually bound to. A generic allow does not count.
open_command_port() {
  local user runtime_dir uid status attempt host port
  user=$1
  runtime_dir=$(runtime_dir_for "$user") || return
  uid=${runtime_dir##*/}
  status="$runtime_dir/nudgelan/status.json"
  if [ ! -f /etc/ufw/ufw.conf ] || ! grep -q '^ENABLED=yes' /etc/ufw/ufw.conf; then
    echo "==> UFW is off. The command port is reachable."
    return 0
  fi
  if [ ! -d "$runtime_dir" ] || ! as_user "$user" systemctl --user --quiet is-active nudgelan-agent.service; then
    echo "==> Firewall setup for $user is pending. Once the agent is listening, allow the LAN port from the NudgeLAN panel."
    return 0
  fi
  attempt=0
  while [ "$attempt" -lt 20 ]; do
    if [ -s "$status" ] && jq -e '.listening == true and (.host | length) > 0 and .port > 0' "$status" >/dev/null; then
      host=$(jq -r '.host' "$status")
      port=$(jq -r '.port' "$status")
      if /usr/lib/nudgelan/nudgelan-firewall-configure --apply "$host" "$port" --owner-uid "$uid"; then
        return 0
      fi
    fi
    attempt=$((attempt + 1))
    sleep 0.5
  done
  echo "==> NudgeLAN could not open the command port for $user." >&2
  return 1
}

configure_user() {
  local user
  user=$1
  # Start the agent before the pill loads, or the shell reports it as down.
  if start_agent "$user"; then
    open_command_port "$user" || echo "==> Warning: firewall setup for $user is pending. Once the agent is listening, allow the LAN port from the NudgeLAN panel." >&2
  else
    echo "==> Warning: NudgeLAN could not start for $user. Check the user service; once it is listening, allow the LAN port from the NudgeLAN panel if needed." >&2
  fi
  copy_plugin "$user"
  enable_plugin "$user"
}

setup_machine() {
  local found user
  systemctl enable --now avahi-daemon
  systemctl --global enable nudgelan-agent.service
  found=0
  while IFS= read -r user; do
    [ -n "$user" ] || continue
    found=1
    configure_user "$user"
  done <<EOF
$(target_users)
EOF
  if [ "$found" -ne 1 ]; then
    echo "==> NudgeLAN could not find the desktop user to enable the pill." >&2
    return 1
  fi
}

remove_firewall_rules() {
  if [ -x /usr/lib/nudgelan/nudgelan-firewall-configure ]; then
    /usr/lib/nudgelan/nudgelan-firewall-configure --remove-all >/dev/null || true
  fi
}

users_with_nudgelan() {
  local name _password _uid _gid _gecos home _shell plugin_path
  getent passwd | while IFS=: read -r name _password _uid _gid _gecos home _shell; do
    [ -n "$home" ] && [ "$home" != "/" ] || continue
    plugin_path="$home/.config/omarchy/plugins/$plugin_id"
    if [ -e "$plugin_path" ] || [ -L "$plugin_path" ]; then
      printf '%s\n' "$name"
      continue
    fi
    if [ -f "$home/.config/omarchy/shell.json" ] && grep -q "$plugin_id" "$home/.config/omarchy/shell.json"; then
      printf '%s\n' "$name"
    fi
  done
}

hide_plugin() {
  local user runtime_dir
  user=$1
  runtime_dir=$(runtime_dir_for "$user") || return
  [ -d "$runtime_dir" ] || return 0
  # Ask the running shell to drop the pill. Editing shell.json alone leaves it
  # on screen until the next login.
  as_user "$user" omarchy plugin disable "$plugin_id" >/dev/null 2>&1 || true
}

remove_user() {
  local user home runtime_dir
  user=$1
  home=$(user_home "$user")
  [ -n "$home" ] || return 0
  runtime_dir=$(runtime_dir_for "$user") || return
  if [ -d "$runtime_dir" ]; then
    as_user "$user" systemctl --user disable --now nudgelan-agent.service >/dev/null 2>&1 || true
  fi
  strip_shell_json "$user" || true
  as_user "$user" rm -rf -- \
    "$home/.config/omarchy/plugins/$plugin_id" \
    "$home/.config/nudgelan" \
    "$home/.local/state/nudgelan" \
    "$home/.config/omarchy/nudgelan-listening.json"
  if [ -d "$runtime_dir" ]; then
    as_user "$user" rm -rf -- "$runtime_dir/nudgelan"
    as_user "$user" omarchy-shell shell reloadConfig >/dev/null 2>&1 || true
    as_user "$user" omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
  fi
}

post_install() {
  set -euo pipefail
  setup_machine
}

post_upgrade() {
  set -euo pipefail
  local user previous_keep_loaded
  while IFS= read -r user; do
    [ -n "$user" ] || continue
    previous_keep_loaded=false
    if as_user "$user" sh -c 'jq -e ".keepLoaded == true" "$HOME/.config/omarchy/plugins/$1/manifest.json"' \
      sh "$plugin_id" >/dev/null 2>&1; then
      previous_keep_loaded=true
    fi
    if as_user "$user" systemctl --user daemon-reload 2>/dev/null; then
      as_user "$user" systemctl --user try-restart nudgelan-agent.service || \
        echo "==> Warning: Could not restart NudgeLAN for $user." >&2
    fi
    if copy_plugin "$user"; then
      if as_user "$user" omarchy-shell shell rescanPlugins >/dev/null 2>&1 &&
        [ "$previous_keep_loaded" = true ]; then
        # The first scan reads the new manifest. The next reload can evict the kept service.
        as_user "$user" omarchy-shell shell rescanPlugins >/dev/null 2>&1 || true
      fi
    else
      echo "==> Warning: Could not refresh the NudgeLAN plugin for $user." >&2
    fi
  done <<EOF
$(users_with_nudgelan)
EOF
}

# Runs before pacman deletes /usr. The shell can still see the plugin and
# removes the pill from the bar immediately.
pre_remove() {
  set -euo pipefail
  local user
  while IFS= read -r user; do
    [ -n "$user" ] || continue
    hide_plugin "$user"
  done <<EOF
$(users_with_nudgelan)
EOF
  # The helper is still installed during pre_remove.
  remove_firewall_rules
}

post_remove() {
  set -euo pipefail
  local user
  systemctl --global disable nudgelan-agent.service || true
  while IFS= read -r user; do
    [ -n "$user" ] || continue
    remove_user "$user"
  done <<EOF
$(users_with_nudgelan)
EOF
}
